{
  "enabledPlugins": {
    "bit@bit-pro": true,
    "cobra-viper@go-skills": true,
    "fileflow-pathologize@go-skills": true,
    "go-release@go-skills": true,
    "go-spec-reviewer@go-skills": true,
    "go@go-skills": true,
    "wails@go-skills": true
  },
  "extraKnownMarketplaces": {
    "bit-pro": {
      "source": {
        "source": "github",
        "repo": "B4Dmonkey/bit-pro"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-go.sh",
            "statusMessage": "Running Go fmt+lint..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-go.sh",
            "statusMessage": "Running Go tests (Go files changed)..."
          }
        ]
      }
    ]
  }
}
